# Port the server listens on
PORT=3000
# Public address people use; used in invite links. https:// also turns on Secure cookies.
PUBLIC_URL=http://localhost:3000
# SQLite database file. On cPanel use a folder outside public_html, e.g. /home/<user>/studio-data/studio.db
DATABASE_PATH=./data/studio.db
# Seed fictional demo people and sample work on first start (true/false)
DEMO_MODE=true
# Shared password for the demo accounts
DEMO_PASSWORD=demo-studio-2026
# Optional: Google API key. Enables a check of whether a Drive link is shared as "anyone with the link".
# It never changes sharing and never claims a specific reviewer has access.
GOOGLE_DRIVE_API_KEY=
# Optional: "Continue with Google". Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time wipe of all data; the same phrase is asked on the setup screen. Remove after setup.
# RESET_WORKSPACE=

# Invitation emails through a mailbox (cPanel → Email Accounts). Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Design Dimensions Studio <studio@designdimensions.in>
