{
  "name": "design-dimensions-studio",
  "version": "0.1.0",
  "description": "Design Dimensions creative-production workspace",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "php -S localhost:3000 -t dist api/router.php",
    "dev:client": "vite",
    "build": "vite build",
    "package": "vite build && node scripts/package.js",
    "import-from-turso": "node --disable-warning=ExperimentalWarning scripts/import-from-turso.js",
    "verify": "node --disable-warning=ExperimentalWarning scripts/verify.js",
    "verify:ui": "node --disable-warning=ExperimentalWarning scripts/verify-ui.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.5"
  },
  "type": "module",
  "private": true
}
