{
  "name": "design-dimensions-studio",
  "version": "0.1.0",
  "description": "Design Dimensions creative-production workspace",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "verify": "node --disable-warning=ExperimentalWarning scripts/verify.js",
    "create-admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "verify:ui": "node --disable-warning=ExperimentalWarning scripts/verify-ui.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
